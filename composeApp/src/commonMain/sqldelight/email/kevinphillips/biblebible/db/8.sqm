CREATE TABLE IF NOT EXISTS ActiveReadingPlan (
    plan_id TEXT PRIMARY KEY NOT NULL,
    started_at INTEGER NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE IF NOT EXISTS ReadingPlanProgress (
    reading_id TEXT PRIMARY KEY NOT NULL,
    plan_id TEXT NOT NULL,
    day_number INTEGER NOT NULL,
    completed_at INTEGER NOT NULL,
    source TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_reading_plan_progress_plan
ON ReadingPlanProgress(plan_id, day_number);
