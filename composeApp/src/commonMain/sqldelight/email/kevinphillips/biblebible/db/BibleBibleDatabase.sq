CREATE TABLE IF NOT EXISTS BibleVerses (
    uuid TEXT PRIMARY KEY,
    id TEXT,
    b TEXT,
    c TEXT,
    v TEXT,
    t TEXT,
    version TEXT,
    chapterCount INTEGER,
    created_at TEXT,
    updated_at TEXT
);

insertVerse:
INSERT OR REPLACE INTO BibleVerses (
                uuid,
                id,
                b,
                c,
                v,
                t,
                version,
                chapterCount,
                created_at,
                updated_at
            ) VALUES (?,?,?,?,?,?,?,?, ?, ?);

cleanBibleVerses:
DELETE FROM BibleVerses WHERE created_at < date('now', '-60 days');

selectVersesById:
SELECT BibleVerses.*
FROM BibleVerses WHERE id = ? AND version = ?;

updateVerseTimestamp:
UPDATE BibleVerses SET updated_at = ? WHERE b = ? AND c = ? AND version = ?;

selectVersesByBookId:
SELECT BibleVerses.*
FROM BibleVerses WHERE b = ? AND c = ? AND version = ?;

CREATE INDEX idx_id_bibleId ON BibleVerses(id, version);
CREATE INDEX IF NOT EXISTS idx_verses_bcv ON BibleVerses(b, c, version);
CREATE INDEX IF NOT EXISTS idx_verses_updated_at ON BibleVerses(updated_at);

countVerses:
SELECT COUNT(*) FROM BibleVerses;

removeExcessVerses:
DELETE FROM BibleVerses WHERE uuid IN (
    SELECT uuid FROM BibleVerses ORDER BY updated_at ASC LIMIT (
        SELECT COUNT(*) - ? FROM BibleVerses
    )
);

countVersesByBookId:
SELECT ChapterCounts.chapterCount FROM ChapterCounts WHERE b = ? AND version = ?;

CREATE TABLE IF NOT EXISTS ChapterCounts (
    uuid TEXT PRIMARY KEY,
    b TEXT,
    version TEXT,
    chapterCount INTEGER,
    created_at TEXT
);

insertChapterCount:
INSERT OR REPLACE INTO ChapterCounts (
                uuid,
                b,
                version,
                chapterCount,
                created_at
            ) VALUES (?,?,?,?, ?);

CREATE TABLE IF NOT EXISTS LastCalled (
    id INTEGER PRIMARY KEY,
    time INTEGER NOT NULL
);

insertLastCalled:
INSERT OR REPLACE INTO LastCalled (id, time) VALUES (1, ?);

getLastCalled:
SELECT * FROM LastCalled WHERE id = 1;

cleanLastCalled:
DELETE FROM LastCalled;

CREATE TABLE IF NOT EXISTS ReadingHistory (
    created_at TEXT PRIMARY KEY,
    b TEXT,
    c TEXT
);

insertReadingHistory:
INSERT OR REPLACE INTO ReadingHistory (
                created_at,
                b,
                c
            ) VALUES (?,?,?);

cleanReadingHistory:
DELETE FROM ReadingHistory
WHERE created_at IN (
    SELECT created_at FROM ReadingHistory
    ORDER BY created_at ASC
    LIMIT (SELECT COUNT(*) FROM ReadingHistory) - ?
);

selectReadingHistory:
SELECT ReadingHistory.b, ReadingHistory.c, DATE(ReadingHistory.created_at)
FROM ReadingHistory ORDER BY ReadingHistory.created_at DESC;

countReadingHistory:
SELECT COUNT(*) FROM ReadingHistory;

CREATE TABLE UserPreferences (
    uuid INTEGER PRIMARY KEY DEFAULT 1,
    fontSize REAL NOT NULL DEFAULT 18,
    bibleVersion TEXT NOT NULL DEFAULT 'KJV'
);

insertUserPrefs:
INSERT INTO UserPreferences (uuid, fontSize, bibleVersion)
VALUES (1, 18,'KJV');

updateUserPrefs:
UPDATE UserPreferences SET fontSize = ?, bibleVersion = ? WHERE uuid = 1;

updateUserPrefsBibleVersion:
UPDATE UserPreferences SET bibleVersion = ? WHERE uuid = 1;

selectUserPrefs:
SELECT * FROM UserPreferences;

CREATE TABLE SavedReadingPosition (
    uuid INTEGER PRIMARY KEY CHECK (uuid = 1),
    bookKey TEXT NOT NULL,
    chapter INTEGER NOT NULL CHECK (chapter >= 1),
    bibleVersion TEXT NOT NULL,
    characterOffset INTEGER NOT NULL DEFAULT 0 CHECK (characterOffset >= 0),
    lineFraction REAL NOT NULL DEFAULT 0,
    isHome INTEGER NOT NULL DEFAULT 0,
    lastActiveMillis INTEGER NOT NULL
);

saveReadingSession:
INSERT OR REPLACE INTO SavedReadingPosition (
    uuid, bookKey, chapter, bibleVersion, characterOffset, lineFraction, isHome, lastActiveMillis
) VALUES (1, ?, ?, ?, ?, ?, ?, ?);

selectReadingSession:
SELECT * FROM SavedReadingPosition WHERE uuid = 1;

clearReadingSession:
DELETE FROM SavedReadingPosition WHERE uuid = 1;

CREATE TABLE IF NOT EXISTS SeenBiblicalWords (
    short_id TEXT PRIMARY KEY NOT NULL,
    seen_at INTEGER NOT NULL
);

insertSeenBiblicalWord:
INSERT OR REPLACE INTO SeenBiblicalWords (short_id, seen_at)
VALUES (?, ?);

selectSeenBiblicalWordIds:
SELECT short_id FROM SeenBiblicalWords;

clearSeenBiblicalWords:
DELETE FROM SeenBiblicalWords;

CREATE TABLE IF NOT EXISTS ActiveReadingPlan (
    plan_id TEXT PRIMARY KEY NOT NULL,
    started_at INTEGER NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE IF NOT EXISTS ReadingPlanProgress (
    reading_id TEXT PRIMARY KEY NOT NULL,
    plan_id TEXT NOT NULL,
    day_number INTEGER NOT NULL,
    completed_at INTEGER NOT NULL,
    source TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_reading_plan_progress_plan
ON ReadingPlanProgress(plan_id, day_number);

deactivateAllReadingPlans:
UPDATE ActiveReadingPlan SET is_active = 0;

upsertActiveReadingPlan:
INSERT OR REPLACE INTO ActiveReadingPlan (plan_id, started_at, is_active)
VALUES (?, ?, 1);

selectActiveReadingPlan:
SELECT plan_id, started_at, is_active FROM ActiveReadingPlan
WHERE is_active = 1
ORDER BY started_at DESC
LIMIT 1;

insertReadingPlanProgress:
INSERT OR REPLACE INTO ReadingPlanProgress (reading_id, plan_id, day_number, completed_at, source)
VALUES (?, ?, ?, ?, ?);

deleteReadingPlanProgress:
DELETE FROM ReadingPlanProgress WHERE reading_id = ?;

selectReadingPlanProgressByPlan:
SELECT reading_id, plan_id, day_number, completed_at, source
FROM ReadingPlanProgress
WHERE plan_id = ?
ORDER BY day_number ASC, completed_at ASC;

selectAllReadingPlanProgress:
SELECT reading_id, plan_id, day_number, completed_at, source
FROM ReadingPlanProgress;

CREATE TABLE IF NOT EXISTS BiblicalShortEngagement (
    short_id TEXT PRIMARY KEY NOT NULL,
    view_count INTEGER NOT NULL DEFAULT 0,
    same_session_replay_count INTEGER NOT NULL DEFAULT 0,
    manual_revisit_count INTEGER NOT NULL DEFAULT 0,
    pause_count INTEGER NOT NULL DEFAULT 0,
    total_watch_time_ms INTEGER NOT NULL DEFAULT 0,
    last_watched_at INTEGER NOT NULL DEFAULT 0,
    cycle_seen INTEGER NOT NULL DEFAULT 0
);

upsertShortEngagement:
INSERT OR REPLACE INTO BiblicalShortEngagement (
    short_id, view_count, same_session_replay_count, manual_revisit_count,
    pause_count, total_watch_time_ms, last_watched_at, cycle_seen
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllShortEngagements:
SELECT short_id, view_count, same_session_replay_count, manual_revisit_count,
       pause_count, total_watch_time_ms, last_watched_at, cycle_seen
FROM BiblicalShortEngagement;

selectShortEngagementById:
SELECT short_id, view_count, same_session_replay_count, manual_revisit_count,
       pause_count, total_watch_time_ms, last_watched_at, cycle_seen
FROM BiblicalShortEngagement
WHERE short_id = ?;

resetShortEngagementCycle:
UPDATE BiblicalShortEngagement SET cycle_seen = 0;

clearShortEngagements:
DELETE FROM BiblicalShortEngagement;
